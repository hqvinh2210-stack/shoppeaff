# ----- Ứng dụng -----
ENVIRONMENT=development
DOMAIN=cashback.vn
# Origin của frontend, phân tách bằng dấu phẩy. Bắt buộc đổi khi deploy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Dữ liệu -----
DATABASE_URL=postgresql+psycopg://cashback:cashback@postgres:5432/cashback
REDIS_URL=redis://redis:6379/0

# ----- Xác thực người dùng -----
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
GOOGLE_CLIENT_ID=

# ----- Bí mật webhook / bot (thiếu thì endpoint trả 503) -----
# Dùng cho POST /api/v1/affiliate/webhook: header X-Affiliate-Signature (HMAC-SHA256
# của body gốc) hoặc X-Webhook-Secret (bí mật dùng chung).
AFFILIATE_WEBHOOK_SECRET=change-me-affiliate-webhook-secret
# Dùng cho POST /api/v1/webhooks/zalo: header X-Zalo-Signature (HMAC-SHA256 body gốc).
ZALO_WEBHOOK_SECRET=change-me-zalo-webhook-secret
# Dùng cho các endpoint bot Telegram gọi thay người dùng: header X-Bot-Secret.
TELEGRAM_BOT_SECRET=change-me-telegram-bot-secret

# ----- Zalo OA -----
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=

# ----- Mạng affiliate -----
AFFILIATE_API_KEY=
AFFILIATE_API_SECRET=
ACCESSTRADE_API_TOKEN=
ACCESSTRADE_CAMPAIGN_ID=
ACCESSTRADE_BASE_URL=https://api.accesstrade.vn/v1

# ----- Nghiệp vụ -----
CASHBACK_RATE_PERCENT=70
MINIMUM_WITHDRAWAL_AMOUNT=30000
CURRENCY=VND

# ----- Gửi email (SMTP) -----
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" 16 ký tự tại
# https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu Gmail thường.
# Bỏ trống bất kỳ dòng nào dưới đây thì hệ thống lặng lẽ không gửi mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Gmail bắt buộc From trùng tài khoản đăng nhập; để trống sẽ tự lấy SMTP_USERNAME.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Bee Hoàn Tiền
# Dùng dựng link trong nội dung email.
APP_BASE_URL=http://localhost:3000
